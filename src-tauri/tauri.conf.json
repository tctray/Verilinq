{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VeriLinq App",
  "version": "0.1.1",
  "identifier": "com.verilinq.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VeriLinq",
        "width": 800,
        "height": 600,
        "resizable": true,
        "visible": false,
        "decorations": true

      },
      {
        "label": "intro",
        "url": "intro.html",
        "width": 400,
        "height": 300,
        "decorations": false,
        "transparent": true,
        "center": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://i.pinimg.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' tauri://localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}